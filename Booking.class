package com.mycompany.travelmanagementsystem;

import java.util.ArrayList;
import java.util.Scanner;

import java.util.ArrayList;
import java.util.Scanner;

public class TravelManagementSystem {

    static ArrayList<Location> locations = new ArrayList<>();

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        loadData(); // create locations, hotels, activities

        while (true) {
            System.out.println("\n==== TRAVEL SYSTEM ====");
            System.out.println("1- Sign Up");
            System.out.println("2- Login");
            System.out.println("0- Exit");
            System.out.print("Choose: ");

            int choice = sc.nextInt();
            sc.nextLine();

            if (choice == 0) {
                System.out.println("Goodbye 👋");
                break;
            }

            // SIGN UP
            if (choice == 1) {
                System.out.print("Email: ");
                String email = sc.nextLine();
                System.out.print("Password: ");
                String pass = sc.nextLine();

                AuthService.signup(email, pass);
                pressEnter(sc);
            }

            // LOGIN
            if (choice == 2) {
                System.out.print("Email: ");
                String email = sc.nextLine();
                System.out.print("Password: ");
                String pass = sc.nextLine();

                String role = AuthService.login(email, pass);

                if (role == null) {
                    System.out.println("Wrong email or password");
                    pressEnter(sc);
                } else if (role.equals("ADMIN")) {
                    adminMenu(sc, email, pass);
                } else {
                    customerMenu(sc, email, pass);
                }
            }
        }
    }

    // ================= ADMIN MENU =================
    static void adminMenu(Scanner sc, String email, String password) {

        Admin admin = new Admin(email, password);

        while (true) {
            System.out.println("\n==== ADMIN MENU ====");
            System.out.println("1- Add Location");
            System.out.println("2- Add Hotel to Location");
            System.out.println("0- Logout");
            System.out.print("Choose: ");

            int c = sc.nextInt();
            sc.nextLine();

            if (c == 0) break;

            if (c == 1) {
                System.out.print("Location name: ");
                locations.add(new Location(sc.nextLine()));
                System.out.println("Location added");
            }

            if (c == 2) {
                showLocations();
                System.out.print("Choose location index: ");
                int i = sc.nextInt();
                sc.nextLine();

                System.out.print("Hotel name: ");
                String name = sc.nextLine();
                System.out.print("Price: ");
                double price = sc.nextDouble();
                System.out.print("Rank (stars): ");
                int rank = sc.nextInt();
                sc.nextLine();

                locations.get(i).addHotel(new Hotel(name, price, rank));
                System.out.println("Hotel added");
            }

            pressEnter(sc);
        }
    }

    // ================= CUSTOMER MENU =================
    static void customerMenu(Scanner sc, String email, String password) {

        Customer customer = new Customer(1, "Customer", email, password);

        while (true) {
            System.out.println("\n==== CUSTOMER MENU ====");
            System.out.println("1- Book Package");
            System.out.println("0- Logout");
            System.out.print("Choose: ");

            int c = sc.nextInt();
            sc.nextLine();

            if (c == 0) break;

            if (c == 1) {
                showLocations();
                System.out.print("Choose location: ");
                int locIndex = sc.nextInt();
                sc.nextLine();

                Location loc = locations.get(locIndex);

                // HOTELS
                System.out.println("\nChoose Hotel:");
                for (int i = 0; i < loc.getHotels().size(); i++) {
                    Hotel h = loc.getHotels().get(i);
                    System.out.println(i + " - " + h.getName() +
                            " | Price: " + h.getPrice() +
                            " | Rank: " + h.getRank() + "⭐");
                }

                int hIndex = sc.nextInt();
                sc.nextLine();
                Hotel chosenHotel = loc.getHotels().get(hIndex);

                // ACTIVITIES
                ArrayList<Activity> chosenActivities = new ArrayList<>();
                System.out.println("\nChoose Activities (1=yes, 0=no)");

                for (Activity a : loc.getActivities()) {
                    System.out.print(a.getName() + " (" + a.getPrice() + "): ");
                    int x = sc.nextInt();
                    if (x == 1) chosenActivities.add(a);
                }
                sc.nextLine();

                Booking booking = new Booking(chosenHotel, chosenActivities);
                System.out.println("\nTOTAL PRICE = " + booking.calculateTotal());

                pressEnter(sc);
            }
        }
    }

    // ================= DATA =================
    static void loadData() {

        Location egypt = new Location("Egypt");
        egypt.addHotel(new Hotel("Hilton Cairo", 200, 5));
        egypt.addHotel(new Hotel("Marriott Cairo", 150, 4));
        egypt.addHotel(new Hotel("Steigenberger", 180, 5));
        egypt.addHotel(new Hotel("Tolip", 120, 3));
        egypt.addHotel(new Hotel("Ramses", 90, 2));
        egypt.addActivity(new Activity("Safari", 50));
        egypt.addActivity(new Activity("Diving", 70));

        Location dubai = new Location("Dubai");
        dubai.addHotel(new Hotel("Burj Hotel", 400, 5));
        dubai.addHotel(new Hotel("Atlantis", 350, 5));
        dubai.addHotel(new Hotel("Rove", 200, 4));
        dubai.addHotel(new Hotel("City Max", 150, 3));
        dubai.addHotel(new Hotel("Ibis", 120, 3));
        dubai.addActivity(new Activity("Safari", 80));
        dubai.addActivity(new Activity("Diving", 100));

        Location paris = new Location("Paris");
        paris.addHotel(new Hotel("Eiffel Hotel", 300, 5));
        paris.addHotel(new Hotel("Louvre Hotel", 250, 4));
        paris.addHotel(new Hotel("Opera", 200, 4));
        paris.addHotel(new Hotel("City Inn", 140, 3));
        paris.addHotel(new Hotel("Budget Stay", 100, 2));
        paris.addActivity(new Activity("Safari", 60));
        paris.addActivity(new Activity("Diving", 90));

        locations.add(egypt);
        locations.add(dubai);
        locations.add(paris);
    }

    // ================= HELPERS =================
    static void showLocations() {
        System.out.println("\nAvailable Locations:");
        for (int i = 0; i < locations.size(); i++) {
            System.out.println(i + " - " + locations.get(i).getName());
        }
    }

    static void pressEnter(Scanner sc) {
        System.out.println("\nPress ENTER to continue...");
        sc.nextLine();
    }
}